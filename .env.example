# Server Network Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Performance & Concurrency Tuning
# SERVER_WORKERS defaults to logical CPU core count if omitted
SERVER_WORKERS=8
# TCP Keep-Alive timeout in seconds
SERVER_KEEPALIVE_SECS=75
# Maximum pending TCP connections in OS socket backlog
SERVER_BACKLOG=2048
# Maximum JSON request payload limit in bytes (default: 2MB = 2097152)
MAX_PAYLOAD_BYTES=2097152

# Environment & Observability
APP_ENV=development
RUST_LOG=info
